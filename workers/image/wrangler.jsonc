{
  // カシャケイボの画像アップロード・取得 Worker。
  // R2 への読み書きはこの Worker に一本化し、Firebase Auth の ID token 検証と Firebase App Check token 検証の
  // 両方を通ったリクエストだけを許可する。
  // レシート・明細スクショは機微情報のため、R2 の公開バケット配信は使わない (documents/adr/0001-tech-stack.md)。
  //
  // デプロイは environment 必須: `wrangler deploy --env dev` / `wrangler deploy --env prod`。
  // トップレベルに binding を置かないことで、env 指定なしの誤デプロイを防ぐ。
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kashakeibo-image-worker",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-06",
  "env": {
    "dev": {
      "name": "kashakeibo-image-worker-dev",
      // workers.dev URL で配信する (MVP ではカスタムドメインを使わない)。デプロイ時の warning 抑止のため明記
      "workers_dev": true,
      // アカウント削除で予約された監査ログ (BigQuery) のパージを実行する定期起動 (src/index.ts の scheduled)。
      // 毎時にしているのは、パージ完了までの遅延をユーザーへの約束「数時間以内」に収めるため
      "triggers": {
        "crons": ["0 * * * *"]
      },
      "r2_buckets": [
        {
          "binding": "IMAGE_BUCKET",
          "bucket_name": "kashakeibo-images-dev"
        }
      ],
      "kv_namespaces": [
        {
          // Firebase の公開 JWK のキャッシュ先 (wrangler kv namespace create PUBLIC_JWK_CACHE_KV_DEV で作成済み)
          "binding": "PUBLIC_JWK_CACHE_KV",
          "id": "c003fcbb5016488fb252bb978373c94f"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            // 日次 (アップロード・解析) と月次 (スキャン無料枠) の回数カウンター。判定と加算を直列化して並行リクエストの上限すり抜けを防ぐ
            "name": "USAGE_COUNTER",
            "class_name": "UsageCounter"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["DailyUploadCounter"]
        },
        {
          // 月次スキャン回数の追加に伴い、日次専用の名前から用途を限定しない名前へ改名 (既存インスタンスのデータは引き継がれる)
          "tag": "v2",
          "renamed_classes": [{ "from": "DailyUploadCounter", "to": "UsageCounter" }]
        }
      ],
      "vars": {
        // Firebase プロジェクト ID (firebase/.firebaserc の dev と一致させる)
        "FIREBASE_PROJECT_ID": "kashakeibo-dev",
        // JWK キャッシュの KV キー名。firebase-auth-cloudflare-workers が KV の read/write に使う任意の固定文字列
        "PUBLIC_JWK_CACHE_KEY": "firebase-public-jwk-cache",
        // App Check の JWKS キャッシュの KV キー名 (同じ KV namespace 内で PUBLIC_JWK_CACHE_KEY と別キーにする)
        "APP_CHECK_JWKS_CACHE_KEY": "firebase-app-check-jwks-cache",
        // 明細抽出 (POST /analyses) に使う Gemini のモデル ID。API キーは secret GEMINI_API_KEY (README のデプロイ手順)。
        // gemini-3.7-flash から切替 (issue #50)。実測で抽出精度は同等のまま原価が約1/4 (README の「スキャン原価」)
        "GEMINI_MODEL": "gemini-3.1-flash-lite",
        // スキャン無料枠超過時のプレミアム判定に使う RevenueCat の project (Kashakeibo-dev) と、プレミアム entitlement の ID。
        // secret API key は wrangler secret REVENUECAT_SECRET_API_KEY (README のデプロイ手順)。
        // secret が未登録の間は Worker が全ユーザーを無料プランとして扱う (src/entitlement.ts)
        "REVENUECAT_PROJECT_ID": "proje2d79a89",
        "REVENUECAT_PREMIUM_ENTITLEMENT_ID": "entl34c3809c32",
        // DEBUG エンドポイント (POST /debug/scan-count。今月のスキャン回数を任意の値に設定する) の有効化フラグ。
        // アプリの開発者メニューから残量 0 を作って QA するための経路で、dev 環境にだけ置く。
        // prod の vars にはこの項目を置かず、経路自体が 404 になるようにする (src/handler.ts の handleDebugScanCountSet)
        "DEBUG_ENDPOINTS_ENABLED": "true"
      }
    },
    "prod": {
      "name": "kashakeibo-image-worker-prod",
      // workers.dev URL で配信する (MVP ではカスタムドメインを使わない)。デプロイ時の warning 抑止のため明記
      "workers_dev": true,
      // アカウント削除で予約された監査ログ (BigQuery) のパージを実行する定期起動 (src/index.ts の scheduled)。
      // 毎時にしているのは、パージ完了までの遅延をユーザーへの約束「数時間以内」に収めるため
      "triggers": {
        "crons": ["0 * * * *"]
      },
      "r2_buckets": [
        {
          "binding": "IMAGE_BUCKET",
          "bucket_name": "kashakeibo-images-prod"
        }
      ],
      "kv_namespaces": [
        {
          // Firebase の公開 JWK のキャッシュ先 (wrangler kv namespace create PUBLIC_JWK_CACHE_KV_PROD で作成済み)
          "binding": "PUBLIC_JWK_CACHE_KV",
          "id": "98574226099d44c7a63da1b74a397c04"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            // 日次 (アップロード・解析) と月次 (スキャン無料枠) の回数カウンター。判定と加算を直列化して並行リクエストの上限すり抜けを防ぐ
            "name": "USAGE_COUNTER",
            "class_name": "UsageCounter"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["DailyUploadCounter"]
        },
        {
          // 月次スキャン回数の追加に伴い、日次専用の名前から用途を限定しない名前へ改名 (既存インスタンスのデータは引き継がれる)
          "tag": "v2",
          "renamed_classes": [{ "from": "DailyUploadCounter", "to": "UsageCounter" }]
        }
      ],
      "vars": {
        // Firebase プロジェクト ID (firebase/.firebaserc の prod と一致させる)
        "FIREBASE_PROJECT_ID": "kashakeibo-prod",
        // JWK キャッシュの KV キー名。firebase-auth-cloudflare-workers が KV の read/write に使う任意の固定文字列
        "PUBLIC_JWK_CACHE_KEY": "firebase-public-jwk-cache",
        // App Check の JWKS キャッシュの KV キー名 (同じ KV namespace 内で PUBLIC_JWK_CACHE_KEY と別キーにする)
        "APP_CHECK_JWKS_CACHE_KEY": "firebase-app-check-jwks-cache",
        // 明細抽出 (POST /analyses) に使う Gemini のモデル ID。API キーは secret GEMINI_API_KEY (README のデプロイ手順)。
        // gemini-3.7-flash から切替 (issue #50)。実測で抽出精度は同等のまま原価が約1/4 (README の「スキャン原価」)
        "GEMINI_MODEL": "gemini-3.1-flash-lite",
        // スキャン無料枠超過時のプレミアム判定に使う RevenueCat の project (Kashakeibo) と、プレミアム entitlement の ID。
        // secret API key は wrangler secret REVENUECAT_SECRET_API_KEY (README のデプロイ手順)。
        // secret が未登録の間は Worker が全ユーザーを無料プランとして扱う (src/entitlement.ts)
        "REVENUECAT_PROJECT_ID": "proj80266896",
        "REVENUECAT_PREMIUM_ENTITLEMENT_ID": "entl4e2d6be551"
      }
    }
  }
}
