# Stream Firestore to BigQuery extension のパラメータ (firebase deploy --only extensions で適用)。
# 監査ログ (訂正削除履歴) の正: users/{userId}/transactions の全変更を BigQuery の changelog に記録する。
# 選定の経緯・履歴画面/削除経路の設計は documents/adr/0004 (監査ログの BigQuery 化) を参照。

# Cloud Functions のデプロイ先。Firestore (asia-northeast1) と揃える
LOCATION=asia-northeast1
# BigQuery データセットのロケーション。Firestore と同リージョンにしてデータの越境を避ける
DATASET_LOCATION=asia-northeast1
# Firestore の DB とそのリージョン (gcloud firestore databases describe の locationId と一致させる)
DATABASE_ID=(default)
DATABASE_REGION=asia-northeast1
# 監査対象のコレクション。{userId} は path_params 列に記録され、uid 絞り込みに使う
COLLECTION_PATH=users/{userId}/transactions
# path_params 列 (uid) を有効化する。Worker の GET /audit-logs が uid で絞るために必須
WILDCARD_IDS=true
DATASET_ID=firestore_export
TABLE_ID=transactions
# changelog の記録時刻 (timestamp 列) による日次パーティション。無料プランの期間下限 (timestamp >= 下限) の
# クエリがそのままパーティションプルーニングされ、テーブルが成長してもスキャン量が期間に比例して抑えられる
# (取り込み時刻の擬似列 _PARTITIONTIME ではなくクエリ条件と同じ列で分割するため、クエリ側の追加条件が要らない)
# パーティション種別のパラメータ名は TABLE_PARTITIONING (extension 実行時 config の要求名。
# TIME_PARTITIONING という名前では無視され、未パーティションのテーブルが作られる)
TABLE_PARTITIONING=DAY
TIME_PARTITIONING_FIELD=timestamp
TIME_PARTITIONING_FIELD_TYPE=TIMESTAMP
# uid を含む document_name でクラスタリングし、ユーザー単位のクエリのスキャン量を抑える
CLUSTERING=document_name
# 訂正の変更フィールド算出に old_data (変更前スナップショット) が必要なため除外しない
EXCLUDE_OLD_DATA=no
