#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.release.xcconfig"
#include "Generated.xcconfig"

// debug ビルドと release / profile ビルドで bundle ID を分け、dev / prod の
// Firebase Auth Keychain の状態が同一端末で混ざらないようにする。Release config に加え、
// Release.xcconfig を継承する Profile config もこの prod 値を使う。
APP_BUNDLE_IDENTIFIER = com.bannzai.kashakeibo
