# 1Password secret references: op run --env-file .env.1password -- <command> が環境変数として渡す。
# 値は書かない。op://<vault>/<item>/<field> の参照だけを書く。
GEMINI_API_KEY=op://kashakeibo/GEMINI_API_KEY/password
GEMINI_API_KEY_DEV=op://kashakeibo/GEMINI_API_KEY_DEV/password
GEMINI_API_KEY_PROD=op://kashakeibo/GEMINI_API_KEY_PROD/password
REVENUECAT_PROJECT_CONFIGURATION_API_KEY_V2_DEV=op://kashakeibo/REVENUECAT_PROJECT_CONFIGURATION_API_KEY_V2_DEV/password
REVENUECAT_PROJECT_CONFIGURATION_API_KEY_V2_PROD=op://kashakeibo/REVENUECAT_PROJECT_CONFIGURATION_API_KEY_V2_PROD/password
REVENUECAT_SECRET_API_KEY_DEV=op://kashakeibo/REVENUECAT_SECRET_API_KEY_DEV/password
REVENUECAT_SECRET_API_KEY_PROD=op://kashakeibo/REVENUECAT_SECRET_API_KEY_PROD/password
REVENUECAT_TESTSTORE_API_KEY_DEV=op://kashakeibo/REVENUECAT_TESTSTORE_API_KEY_DEV/password
REVENUECAT_TESTSTORE_API_KEY_PROD=op://kashakeibo/REVENUECAT_TESTSTORE_API_KEY_PROD/password
