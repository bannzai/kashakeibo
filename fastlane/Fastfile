# 審査提出の lane submit_for_review は release-app skill の雛形を読み込む (雛形の無い CI 等では読み込まない)。
# 引数と前提は雛形のヘッダーコメントを参照
release_app_submit_for_review_fastfile = ENV.fetch('RELEASE_APP_SUBMIT_FOR_REVIEW_FASTFILE', File.expand_path('~/.agents/skills/release-app/templates/submit_for_review/Fastfile'))
import(release_app_submit_for_review_fastfile) if File.exist?(release_app_submit_for_review_fastfile)

default_platform(:ios)

platform :ios do
  desc "Upload metadata and screenshots to App Store Connect"
  lane :metadata_upload do
    ENV['FASTLANE_ENABLE_BETA_DELIVER_SYNC_SCREENSHOTS'] = 'true'
    upload_to_app_store(
      # force is true means skip check with preview.html
      force: true,
      # https://docs.fastlane.tools/actions/deliver/
      # Sync screenshots with local ones. This is currently beta option so set true to 'FASTLANE_ENABLE_BETA_DELIVER_SYNC_SCREENSHOTS' environment variable as well
      sync_screenshots: true,
      run_precheck_before_submit: false,
      automatic_release: true,
      phased_release: true,
      reset_ratings: false,
      metadata_path: 'fastlane/metadata',
      screenshots_path: 'fastlane/screenshots',
      skip_binary_upload: true,
      submit_for_review: false,
      ignore_language_directory_validation: true
    )
  end
end
