# 1Password secret references (prod): 本番の値を使う操作だけ op run --env-file .env.1password.prod -- <command> で渡す。
# 既定の .env.1password には入れない (開発コマンドの子プロセスに本番の値を渡さないため)。値は書かない。
GEMINI_API_KEY_PROD=op://kashakeibo/GEMINI_API_KEY_PROD/password
REVENUECAT_PROJECT_CONFIGURATION_API_KEY_V2_PROD=op://kashakeibo/REVENUECAT_PROJECT_CONFIGURATION_API_KEY_V2_PROD/password
REVENUECAT_SECRET_API_KEY_PROD=op://kashakeibo/REVENUECAT_SECRET_API_KEY_PROD/password
REVENUECAT_TESTSTORE_API_KEY_PROD=op://kashakeibo/REVENUECAT_TESTSTORE_API_KEY_PROD/password
